rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Fonctions communes
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isActiveUser() {
      return isAuthenticated()
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.active == true;
    }

    function isAdmin() {
      return isActiveUser()
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'admin';
    }

    function isTeacher() {
      return isActiveUser()
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'teacher';
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      // Administrateur : lecture complète.
      allow read: if isAdmin();

      // Professeur :
      // peut consulter les profils des professeurs actifs.
      // Ces informations sont nécessaires notamment pour
      // gérer les séances assurées par plusieurs professeurs.
      allow read: if isTeacher()
                  && resource.data.role == 'teacher'
                  && resource.data.active == true;

      // Seul l'administrateur peut modifier les utilisateurs.
      allow write: if isAdmin();
    }
    
    // ============================================================
    // TEACHERS
    // ============================================================

    match /teachers/{teacherId} {

      allow read: if isAdmin() || isTeacher();

      allow write: if isAdmin();
    }

    // ============================================================
    // MEMBERS
    // ============================================================

    match /members/{memberId} {

      // Administrateur : lecture / écriture
      // Professeur : lecture
      allow read: if isAdmin() || isTeacher();

      allow write: if isAdmin();
    }

    // ============================================================
    // GROUPS
    // ============================================================

    match /groups/{groupId} {

      // Administrateur et professeurs peuvent consulter
      // les groupes.
      allow read: if isAdmin() || isTeacher();

      // Seul l'administrateur peut créer/modifier/désactiver
      // les groupes.
      allow write: if isAdmin();
    }

// ============================================================
// ENROLLMENTS
// ============================================================

match /enrollments/{enrollmentId} {

  // Administrateur et professeurs peuvent consulter
  // les inscriptions.
  allow read: if isAdmin() || isTeacher();

  // Administrateur : accès complet.
  allow create, update, delete: if isAdmin();

  // ----------------------------------------------------------
  // Professeur : création d'une inscription
  // ----------------------------------------------------------
  //
  // Nécessaire notamment lors d'un changement de groupe.
  // Le groupe de destination doit être actif.
  // L'adhérent doit exister.
  // La saison doit correspondre à celle du groupe.
  //
  allow create: if isTeacher()
    && request.resource.data.memberId is string
    && request.resource.data.groupId is string
    && request.resource.data.seasonId is string
    && request.resource.data.isActive == true
    && request.resource.data.endDate == null

    && exists(
      /databases/$(database)/documents/members/$(request.resource.data.memberId)
    )

    && exists(
      /databases/$(database)/documents/groups/$(request.resource.data.groupId)
    )

    && get(
      /databases/$(database)/documents/groups/$(request.resource.data.groupId)
    ).data.isActive == true

    && request.resource.data.seasonId ==
       get(
         /databases/$(database)/documents/groups/$(request.resource.data.groupId)
       ).data.seasonId

    && request.resource.data.createdBy ==
       request.auth.uid

    && request.resource.data.updatedBy ==
       request.auth.uid;

  // ----------------------------------------------------------
  // Professeur : clôture d'une inscription
  // ----------------------------------------------------------
  //
  // Le professeur doit faire partie des enseignants
  // du groupe de départ.
  //
  // Il peut seulement :
  // - désactiver l'inscription
  // - renseigner endDate
  // - modifier updatedAt / updatedBy
  //
  allow update: if isTeacher()

    && exists(
      /databases/$(database)/documents/groups/$(resource.data.groupId)
    )

    && request.auth.uid in get(
      /databases/$(database)/documents/groups/$(resource.data.groupId)
    ).data.teacherIds

    // L'inscription doit être active avant l'opération.
    && resource.data.isActive == true

    // Elle doit être désactivée.
    && request.resource.data.isActive == false

    // Les données structurantes ne peuvent pas changer.
    && request.resource.data.memberId ==
       resource.data.memberId

    && request.resource.data.groupId ==
       resource.data.groupId

    && request.resource.data.seasonId ==
       resource.data.seasonId

    && request.resource.data.startDate ==
       resource.data.startDate

    && request.resource.data.createdAt ==
       resource.data.createdAt

    && request.resource.data.createdBy ==
       resource.data.createdBy

    && request.resource.data.updatedBy ==
       request.auth.uid

    // Seuls ces champs peuvent être modifiés.
    && request.resource.data
         .diff(resource.data)
         .affectedKeys()
         .hasOnly([
           'isActive',
           'endDate',
           'updatedAt',
           'updatedBy'
         ]);

  // Un professeur ne supprime jamais physiquement
  // une inscription.
  allow delete: if false;
}

    // ============================================================
    // SESSIONS
    // ============================================================

    match /sessions/{sessionId} {

      // Administrateur : accès complet.
      allow read, write: if isAdmin();

      // Professeur :
      // - peut lire les séances auxquelles il est affecté
      // - peut modifier uniquement une séance dont il est
      //   l'un des professeurs.
      allow read: if isTeacher()
                  && request.auth.uid in resource.data.teacherIds;

      allow update: if isTeacher()
                    && request.auth.uid in resource.data.teacherIds
                    && request.auth.uid in request.resource.data.teacherIds;

      allow create: if isTeacher()
                    && request.auth.uid in request.resource.data.teacherIds;

      allow delete: if isTeacher()
                    && request.auth.uid in resource.data.teacherIds;
    }

    // ============================================================
    // ATTENDANCE
    // ============================================================

    match /attendance/{attendanceId} {

      // Administrateur : accès complet.
      allow read, write: if isAdmin();

      // ----------------------------------------------------------
      // Professeur : lecture d'une présence
      // ----------------------------------------------------------
      allow read: if isTeacher()
        && exists(
          /databases/$(database)/documents/sessions/$(resource.data.sessionId)
        )
        && request.auth.uid in get(
          /databases/$(database)/documents/sessions/$(resource.data.sessionId)
        ).data.teacherIds;

      // ----------------------------------------------------------
      // Professeur : création d'une présence
      // ----------------------------------------------------------
      allow create: if isTeacher()
        && exists(
          /databases/$(database)/documents/sessions/$(request.resource.data.sessionId)
        )
        && request.auth.uid in get(
          /databases/$(database)/documents/sessions/$(request.resource.data.sessionId)
        ).data.teacherIds;

      // ----------------------------------------------------------
      // Professeur : modification d'une présence existante
      // ----------------------------------------------------------
      allow update: if isTeacher()
        && exists(
          /databases/$(database)/documents/sessions/$(resource.data.sessionId)
        )
        && request.auth.uid in get(
          /databases/$(database)/documents/sessions/$(resource.data.sessionId)
        ).data.teacherIds;

      // ----------------------------------------------------------
      // Suppression : réservée à l'administrateur
      // ----------------------------------------------------------
      allow delete: if isAdmin();
    }
  }
}